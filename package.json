  "bugs": {
    "url": "https://github.com/GYC159159/DSH/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "deepseek",
    "task-cost",
    "budget",
    "tokens",
    "任务花销"
  ],
  "engines": {
    "dsh": ">=0.2.0"
  },
  "publishConfig": {
    "access": "public"
